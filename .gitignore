# --- 1. IGNORAR ARCHIVOS DE SISTEMA ---

# Archivos generados por sistemas operativos (Windows / macOS)
.Ds_Store
Thumbs.db
desktop.ini

# --- 2. REGLAS UNIVERSALES DE COMPILACIÓN (JAVA / JS) ---

# Carpetas de salida de la compilación/empaquetado
*/build/
/dist/
/out/

# Archivos de compilación de Java (bytecode)
*.class

# Archivos de paquete y distribución (Archivos grandes)
*.jar
*.war
*.ear
*.zip
*.tar.gz

# --- 3. REGLAS DE JAVA / APACHE NETBEANS / ECLIPSE ---

# NetBeans specific
/.cache/
/.nb-gradle-properties
/.nb-gradle-version

# Carpetas y archivos de Configuración Local de NetBeans que causaban el problema
nbproject/private/
*.properties
*.xml

# Metadatos de Eclipse (si alguien del equipo usa este IDE)
.classpath
.project
.settings/

# --- 4. REGLAS DE PYTHON / PYCHARM ---

# Ignorar carpetas de entornos virtuales
venv/
.venv/

# Ignorar archivos generados por Python
__pycache__/
*.pyc

# Ignorar carpeta de configuración personal de PyCharm/IntelliJ
.idea/

# Archivos de módulo de PyCharm/IntelliJ
*.iml

# --- 5. REGLAS DE JAVASCRIPT / NODE.JS / VISUAL STUDIO CODE ---

# Dependencias instaladas (la carpeta más grande)
node_modules/

# Archivos de entorno y secretos
.env
.env.local

# Configuración personal del IDE (Visual Studio Code)
.vscode/

# Configuración y logs de NPM/Yarn/Depuración
npm-debug.log*
yarn-debug.log*

# Archivo de configuración local de Quokka.js
.quokka
/Java/Leccion4/Aritmetica/build/
